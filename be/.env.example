# Application
NODE_ENV=development
PORT=3001

# Supabase
# Project URL - RESTful endpoint for querying and managing your database
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key - Secret key to bypass RLS (use for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Frontend
FRONTEND_URL=http://localhost:5173
